FROM node:18-alpine

WORKDIR /app

# Install nodemon and ts-node globally (or use npx in scripts, but global is convenient for dev)
RUN npm install -g nodemon ts-node

# Copy package files
COPY package*.json ./

# Install all dependencies
RUN npm install

# Expose port
EXPOSE 8000

# Start command (can be overridden by docker-compose)
CMD ["npm", "run", "dev"]
